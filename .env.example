APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

#
# Docker Compose development
# --------------------------------------------------------------------------
# The values below target the compose stack from the host via published
# 127.0.0.1 ports, so host-run artisan and `php artisan serve` share the same
# MySQL/Redis/Mailpit the containers use (requires ext-redis on host PHP).
# Inside containers these are overridden by the service environment in
# docker-compose.yml:
#
#   MySQL:   127.0.0.1:33061   (container-internal: mysql:3306)
#   Redis:   127.0.0.1:6379    (container-internal: redis:6379)
#   Mailpit: SMTP 127.0.0.1:1025, UI http://localhost:8025
#
# After changing values here while containers run, recreate them:
#   docker compose up -d --force-recreate
# --------------------------------------------------------------------------

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=hardware_supply
DB_USERNAME=hardware_supply
DB_PASSWORD=hardware_supply_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CATALOG_MEDIA_DISK=r2

CHECKOUT_RESERVATION_TTL=15

# Payments / PayRex gateway (Phase 5). Leave PAYREX_SECRET_KEY empty to run
# on the credential-free FakePaymentGateway. The webhook secret is issued by
# the PayRex Dashboard when a webhook endpoint is registered.
PAYMENTS_ENABLED=false
PAYMENTS_GATEWAY=
PAYMENTS_FAKE_MODE=false
PAYMENTS_MAX_ATTEMPTS=3
PAYMENTS_QUEUE=payments
PAYMENTS_SUCCESS_URL=/orders/{order}/paid
PAYMENTS_CANCEL_URL=/checkout
PAYREX_PUBLIC_KEY=
PAYREX_SECRET_KEY=
PAYREX_WEBHOOK_SECRET=
PAYREX_WEBHOOK_TOLERANCE=300

# Administration & reporting (Phase 8).
REPORTS_DISK=local
REPORTS_EXPORT_TTL_DAYS=7
REPORTS_DOWNLOAD_TTL_MINUTES=30
REPORTS_QUEUE=reports
REPORTS_MAX_RANGE_DAYS=366

# Outbound webhooks (Phase 8).
WEBHOOKS_QUEUE=webhooks
WEBHOOKS_HTTP_TIMEOUT=5
WEBHOOKS_API_VERSION=1.0

# Privacy / right-to-erasure (Phase 8).
PRIVACY_DELETION_GRACE_DAYS=7

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hardware-supply.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Cloudflare R2 S3-endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
